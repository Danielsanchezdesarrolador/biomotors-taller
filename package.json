{
  "name": "biomotors-taller",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "node scripts/generate-pwa-icons.mjs",
    "postbuild": "node scripts/verify-pwa.mjs && node scripts/verify-official-bundle.mjs && node scripts/verify-dark-brand.mjs",
    "predev": "node scripts/generate-pwa-icons.mjs",
    "dev:harness": "vite --config vite.harness.config.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "^0.548.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
