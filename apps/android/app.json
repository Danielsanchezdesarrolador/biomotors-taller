{
  "expo": {
    "name": "ByteTorque",
    "slug": "bytetorque-android",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F8FD",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "cl.bytetorque.demo",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#061c39"
      }
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "environment": "demo"
    },
    "icon": "./assets/brand/icon.png",
    "splash": {
      "image": "./assets/brand/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#061c39"
    }
  }
}
