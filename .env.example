# ByteTorque — EJEMPLO, SIN CREDENCIALES REALES
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# OFF por defecto. Activar solo tras revisión del Director y pruebas controladas.
VITE_BT_AUTH_R1_ENABLED=false
# Privado, apagado. Requiere Auth R1 y autorización de pruebas con fichas ficticias.
VITE_BT_CP03_PRIVATE_ENABLED=false
# CP04 candidato, NO activar sin SQL alojado autorizado y QA sintético de RLS.
VITE_BT_CP04_PRIVATE_ENABLED=false
# URL autorizada: https://suxcqqnmcjoezfxltoms.supabase.co
# Clave permitida: sb_publishable_… (copiar únicamente desde Publishable keys).
# Nunca pegar contraseñas, claves secretas ni JWT en variables públicas.
# No incluir SUPABASE_SERVICE_ROLE_KEY, secretos SMTP ni claves de pago en variables VITE_*
# Los secretos privados se configuran solamente en backend/servicios seguros.

# CP05: enable only after separately approved hosted SQL and RLS validation.
VITE_BT_CP05_PRIVATE_ENABLED=false

# CP06 candidate: final rollout authorization required, no new SQL.
VITE_BT_CP06_PRIVATE_ENABLED=false

# Additional independent gates; server approvals remain mandatory.
VITE_BT_CP05_DOCUMENTS_ENABLED=false
VITE_BT_CP05_EMAIL_ENABLED=false

# PLAN-04B/C candidates: install authorized SQL and verify before enabling.
VITE_BT_PLAN04_WORKSHOPS_ENABLED=false

# BT-REG-01: candidate only. Requires approved SQL + independent per-workshop backend rollout.
VITE_BT_RECORDS_PRIVATE_ENABLED=false

# BT-EXP-01 candidate. Server read/write gates and per-workshop rollout are independent.
VITE_BT_FINAL_ARCHIVE_ENABLED=false

# BT-AGENDA-01 candidate: SQL and per-workshop rollout require separate authorization.
VITE_BT_AGENDA_ENABLED=false
